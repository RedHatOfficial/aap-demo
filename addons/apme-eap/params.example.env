# Edit values, then deploy manually:
#   oc process --local -f ../portal/deploy.yaml --param-file=portal-params.env | oc apply -f -
#   oc process --local -f deploy-apme.yaml --param-file=apme-params.env | oc apply -f -
#
# aap-demo auto-generates ~/.aap-demo/apme-eap-params.env on enable apme-eap

NAMESPACE=apme
CLUSTER_ROUTER_BASE=apps.example.com

RHAAP_URL=
RHAAP_OAUTH_CLIENT_ID=
RHAAP_OAUTH_CLIENT_SECRET=
RHAAP_TOKEN=

# OAuth redirect: https://redhat-rhaap-portal-apme.<CLUSTER_ROUTER_BASE>/api/auth/rhaap/handler/frame?env=production

GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

PORTAL_DB_PASSWORD=
PORTAL_SESSION_SECRET=
ABBENAY_TOKEN=

PORTAL_IMAGE=quay.io/cferman/portal-hub-eap:latest
EXCLUDE_APME_PLUGINS=false
# ROUTE_TLS_TERMINATION=edge
# ROUTE_TLS_CERT_PATH=~/.aap-demo/apme-eap-tls/tls.crt
# ROUTE_TLS_KEY_PATH=~/.aap-demo/apme-eap-tls/tls.key
