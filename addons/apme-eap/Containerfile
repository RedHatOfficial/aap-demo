# Preload all six APME plugins from the checked-in Docker/OCI archive.
# Build context: addons/apme-eap/ (includes plugin_packs/ and ci/).
# Override BASE_IMAGE for the target architecture; the default is RHDH 1.9
# for amd64. The arm64 build uses quay.io/rhdh-community/rhdh:1.9.
# When replacing the bundled archive, pass its independently verified digest
# with --build-arg PLUGIN_PACK_SHA256=sha256:<hex>.
ARG BASE_IMAGE=registry.redhat.io/rhdh/rhdh-hub-rhel9:1.9
FROM ${BASE_IMAGE}

USER root

# SHA256 of the bundled apme-prototype-plugins-8593383-20260718025043 pack.
ARG PLUGIN_PACK_SHA256=sha256:943f67afce1f9d1852df09b74da0126ef73f861e1ffc066e5196cc3701f341c3
COPY plugin_packs/apme-prototype-plugins-*.oci.tar.gz /tmp/plugin-pack.tar.gz
COPY ci/extract-plugin-pack.py /tmp/extract-plugin-pack.py
RUN PLUGIN_PACK_SHA256="${PLUGIN_PACK_SHA256}" PLUGIN_PACK_FORMAT=oci \
    python3 /tmp/extract-plugin-pack.py \
    && rm /tmp/plugin-pack.tar.gz /tmp/extract-plugin-pack.py

USER 1001
