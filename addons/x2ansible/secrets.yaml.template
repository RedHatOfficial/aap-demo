# ============================================================================
# WARNING: This is a TEMPLATE file. DO NOT commit actual secrets to git!
# ============================================================================
#
# On aap-demo, credentials are normally created interactively:
#   aap-demo enable x2ansible
# or updated with:
#   aap-demo config x2ansible
#
# This template documents the supported secret keys. The deploy script writes
# ~/.aap-demo/x2ansible-secrets.yaml automatically.
# ============================================================================
---
kind: Secret
apiVersion: v1
metadata:
  name: x2a-credentials
type: Opaque
stringData:
  # LLM — choose ONE provider block (deploy script prompts for these)

  # AWS Bedrock bearer token (recommended; matches x2ansible getting-started docs)
  LLM_MODEL: "anthropic.claude-3-7-sonnet-20250219-v1:0"
  AWS_REGION: "us-east-1"
  AWS_BEARER_TOKEN_BEDROCK: "REPLACE-WITH-YOUR-AWS-BEARER-TOKEN"

  # OpenAI-compatible alternative
  # OPENAI_API_BASE: "https://api.openai.com/v1"
  # OPENAI_API_KEY: "REPLACE-WITH-YOUR-OPENAI-API-KEY"

  # AWS Bedrock IAM alternative
  # AWS_ACCESS_KEY_ID: "REPLACE-WITH-YOUR-AWS-ACCESS-KEY"
  # AWS_SECRET_ACCESS_KEY: "REPLACE-WITH-YOUR-AWS-SECRET-KEY"

  # AAP integration (auto-discovered on aap-demo when AAP is deployed)
  AAP_URL: "https://your-aap-instance.com"
  AAP_ORG_NAME: "Default"
  AAP_OAUTH_TOKEN: "REPLACE-WITH-YOUR-AAP-TOKEN"
  AAP_SKIP_SSL_VERIFICATION: "true"

  # Optional GitHub OAuth (not required — guest sign-in is enabled for aap-demo labs)
  # AUTH_GITHUB_CLIENT_ID: ""
  # AUTH_GITHUB_CLIENT_SECRET: ""
