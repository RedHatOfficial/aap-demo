# Portal OpenShift Template — manual deploy example
#   oc process --local -f deploy.yaml --param-file=params.example.env | oc apply -f -
#
# aap-demo will generate params when the portal addon uses this template.

NAMESPACE=redhat-rhaap-portal
CLUSTER_ROUTER_BASE=apps.example.com

RHAAP_URL=https://aap-aap-operator.apps.crc.testing
RHAAP_PUBLIC_URL=https://aap-aap-operator.apps.crc.testing
RHAAP_OAUTH_CLIENT_ID=
RHAAP_OAUTH_CLIENT_SECRET=
RHAAP_TOKEN=

# OAuth redirect: https://redhat-rhaap-portal-<NAMESPACE>.<CLUSTER_ROUTER_BASE>/api/auth/rhaap/handler/frame?env=production

GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

PORTAL_DB_PASSWORD=
PORTAL_SESSION_SECRET=

PORTAL_IMAGE=quay.io/cferman/portal-hub-eap:latest
EXCLUDE_APME_PLUGINS=false
APME_URL=http://apme-gateway.apme.svc:8080
DISABLE_SCM_AUTH=true
